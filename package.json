{
  "name": "open-editor-platform-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-content.mjs && astro build && node scripts/write-headers.mjs",
    "preview": "astro preview --port 4321",
    "check": "astro check && node scripts/check-content.mjs",
    "test": "npm run build:variant && playwright test",
    "links": "node scripts/check-links.mjs",
    "build:variant": "SITE_CONFIG=./tests/fixtures/after-release.json astro build --outDir dist-variant"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "5.3.1",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
